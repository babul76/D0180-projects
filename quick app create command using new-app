Complete flow:
oc new-project demo-03
oc new-app --name=test-app httpd
oc get pods
oc get svc
oc expose svc/test-app
oc get route
oc describe route/test-app
curl http://$(oc get route test-app -o jsonpath='{.spec.host}')



3.Fill the required pvc details
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: babulh-dynamic-pvc
  namespace: babulh-13
spec:
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 1Gi

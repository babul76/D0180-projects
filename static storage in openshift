1.Go to Web UI
2.Storage --> Persistant Volume --> Create PV
3.Fill the required pv details
apiVersion: v1
kind: PersistentVolume
metadata:
  name: soumya-pv
spec:
  capacity:
    storage: 1Gi
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  nfs:
    path: /do-180
    server: 10.10.10.105
  claimRef:
    namespace: soumyapractice3
    name: soumya-pvc
4.Fill the required pvc details
apiVersion: v1
kind: PersistentVolume
metadata:
  name: soumya-pv
  namespace: soumyapractice3
spec:
  accessModes:
    - ReadWriteMany
  resources:
	requests:
		storage: 1Gi
  volumeName: soumya-pv
  
